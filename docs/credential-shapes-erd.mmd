erDiagram
    CREDENTIAL_CLASS ||--o{ CREDENTIAL : classifies
    PROJECT ||--o{ CREDENTIAL : "declares + consumes"
    PROJECT ||--|| RESOLVER : "declares exactly ONE shape"
    CREDENTIAL }o--|| ONEPASSWORD_VAULT : "sourced from (shared classes)"
    CREDENTIAL }o--|| SOPS_AGE_FILE : "sourced from (project-scoped)"
    CREDENTIAL }o--|| FORGE_SECRET : "sourced from (CI only)"
    CREDENTIAL ||--o{ CACHE_STORE : "cached copy (derived, disposable)"
    RESOLVER ||--o{ CACHE_STORE : "materializes at runtime"
    REGISTRY ||--o{ CREDENTIAL : "name-to-op-ref map (shared creds only)"

    CREDENTIAL_CLASS {
        string name PK "HumanLogin | ProviderToken | ProjectApiKey | ServiceSecret | RepoIaCSecret | CISecret | SigningKey"
        string default_source "fixed per class"
        string isolation "token scoping, not vault walls"
    }

    CREDENTIAL {
        string name PK "e.g. sonarr-api-key-media"
        string class FK
        string scope "project | machine | account"
        string source_ref "op://... | secrets/foo.sops.yml | CI var name"
        string status "shared-exception must be registered"
    }

    ONEPASSWORD_VAULT {
        string name PK "Identity | Provider_Tokens | Service_Records"
        string principle "class-based, never project-based"
        string role "browser + cross-machine source of truth"
    }

    SOPS_AGE_FILE {
        string path PK "committed, encrypted in repo"
        string key_model "one age key per project, backed up to 1P"
        string role "portable, clone-plus-key capability"
    }

    FORGE_SECRET {
        string scope PK "Forgejo org/repo vars"
        string role "CI-only credentials, never local"
    }

    RESOLVER {
        string shape PK "sops-inline | cove-vault-get | op-read-once | forge-only"
        string visibility_gate "sops-inline only when PROJECT.visibility = private"
        string failure_mode "fail-loud: names ref + stage, no fallbacks, no empty strings"
        string declared_in "project AGENTS.md, one line"
    }

    CACHE_STORE {
        string kind PK "cove-vault-op-cache | macos-keychain | dotenv | tmp-cache"
        bool authoritative "always false"
        string lifetime "rebuildable at any time"
    }

    REGISTRY {
        string path PK "creds-registry.yaml (machine-wide, committed, no secrets)"
        string maps "credential name to source ref"
        string replaces "ad-hoc KNOWN_CREDENTIALS and hardcoded item IDs"
    }
