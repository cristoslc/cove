---
# Host-specific vars overlay (auto-generated by `cove up` on first run).
# Copy to <hostname>.yml and edit, or let `cove up` detect values.
#
# admin_username: your-username        # from $USER
# admin_email: you@example.com         # from git config user.email
# op_vault: Private                    # from $OP_VAULT or "Private"
# ts_dns_name: your-host.ts.net        # from `tailscale status --json`