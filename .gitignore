# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Node
node_modules/

# Binaries
/cove
/cove-*

# Build artifacts
/dist/
/build/
cli/build/
*.egg-info/

# Personal agent configs
.claude/
.goose/
bin/

# IDE
.idea/
.vscode/
*.swp
*.swo

# TLS infra (auto-copied from CA by bringup.yml)
/compose/certs/

# Compose runtime data (git repos, DB, SSH keys, TLS certs, Vault)
/compose/data/
/compose/.env
/compose/logs/
gcm-diagnose.log
/compose/vault/raft/

# Host-specific PII overlay (auto-generated by `cove up`)
/compose/host_vars/*.yml
!/compose/host_vars/*.example

# Rendered dnsmasq config (contains hostname)
/compose/dnsmasq/cove.conf

# User-specific credential seeds
/compose/seeds/*.yaml
!/compose/seeds/*.example
# Explicit: the rendered vault-user seed must never be re-tracked, even if the
# glob above ever loosens (incident 20261026-145212 — its 1Password credential
# value shipped in public repo history).
/compose/seeds/vault-user.yaml
# Pytest cache under cli/ (project-local; the root-level glob does not cover it)
cli/.pytest_cache/

# Worktrees
/.worktrees/

# Cove-generated docs (created by cove install)
.agents/agents-md-detail/
!.agents/agents-md-detail/fj.md

.agents/cove/
compose/nginx/default.conf
# Rendered llmproxy edge credentials (client token + active backend key), 0600.
compose/nginx/llmproxy-auth.conf

# Dispatch artifacts (opencode subagent dispatch)
.subagents/
prompts/
plan.yaml

# Bundled compose resources (build artifact — sync from compose/ via cli/scripts/sync_compose_resources.py)
cli/cove/resources/compose/

# Staging venv (created by scripts/staging/deploy.sh)
.staging-venv/
