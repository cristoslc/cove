model_list:
  - model_name: claude-sonnet-4-5
    litellm_params:
      model: anthropic/claude-sonnet-4-5
      api_key: os.environ/ANTHROPIC_API_KEY
  - model_name: gpt-5
    litellm_params:
      model: openai/gpt-5
      api_key: os.environ/OPENAI_API_KEY

litellm_settings:
  drop_params: true
  set_verbose: false

general_settings:
  disable_end_user_auth: true
  disable_mcp: true
  disable_admin_ui: true
  disable_user_management: true
  disable_jwt_auth: true

router_settings:
  routing_strategy: "latency-based-routing"
  enable_pre_call_checks: true

headroom_settings:
  enabled: true
  endpoint: "http://headroom:4001"
  model: "local"
  fallback: "direct"