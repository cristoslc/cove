# Cove Bifrost Gateway credential seed for 1Password.
# Run: cove creds 1p-bulk-write compose/seeds/bifrost-creds.yaml --execute
# (cove bifrost up does this automatically when no shared item exists.)
# Copy to bifrost-creds.yaml to pin values for your host.
#
# This item holds the config-store encryption key and the dashboard admin
# password, keyed to the https://bifrost.cove.local/ URL (NOT per-hostname).
# The admin USERNAME comes from the SHARED 'Cove Admin' item (keyed to
# https://cove.local/, ADR-017). The CLIENT virtual key is not held here:
# Bifrost v2.3.x generates virtual-key tokens itself (ignoring any seed
# value), so `cove bifrost up` fetches the generated token from the
# gateway's admin API and projects it into the compose .env
# (BIFROST_CLIENT_VIRTUAL_KEY). Provider API keys are NOT held here: the
# Synthetic key is projected from the LiteLLM local.env and the ollama-cloud
# key is projected by the workstation lane (ownership ruling, 2026-10-26).

items:
  - title: "Bifrost Gateway"
    vault: Private
    category: login
    fields:
      encryption_key[concealed]: "{{generate:encryption_key}}"
      admin_password[concealed]: "{{generate:admin_password}}"
      url[text]: "https://bifrost.cove.local/"
      purpose[text]: "Bifrost gateway credentials (admin username is the shared Cove Admin item, ADR-017; client virtual key is Bifrost-generated, see cove bifrost up)"