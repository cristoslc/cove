# Cove Speedtest Tracker credential seed for 1Password.
# Run: cove creds 1p-bulk-write compose/seeds/speedtest-creds.yaml --execute
# (cove speedtest up does this automatically when no shared item exists.)
# Copy to speedtest-creds.yaml to pin values for your host.
#
# This item holds ONLY the Speedtest Tracker APP_KEY, keyed to the
# https://speedtest.cove.local/ URL (NOT per-hostname). The admin email/password
# come from the SHARED 'Cove Admin' item (keyed to https://cove.local/, ADR-017),
# which is the unified Cove admin identity used across all Cove services.
# `cove speedtest up` checks for this item first and reuses it; it only
# generates a new APP_KEY when no such item exists.

items:
  - title: "Speedtest Tracker"
    vault: Private
    category: login
    fields:
      app_key[concealed]: "{{generate:64}}"
      url[text]: "https://speedtest.cove.local/"
      purpose[text]: "Speedtest Tracker APP_KEY (admin identity is the shared Cove Admin item, ADR-017)"
