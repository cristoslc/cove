# Map client User-Agent to platform name for /config/dns auto-detection.
# The /config/dns endpoint uses $config_dns_type to serve the correct
# DNS setup script for the visitor's operating system.
map $http_user_agent $config_dns_type {
    default                      "unknown";
    "~*Macintosh"                "macos";
    "~*Windows NT"               "windows";
    "~*Android"                  "android";
    "~*iPhone"                   "ios";
    "~*iPad"                     "ios";
    "~*iPod"                     "ios";
    "~*Linux"                    "linux";
}

# Map the WebSocket upgrade header to the Connection header for proxied
# long-lived connections (bb's realtime channel at /ws upgrades through nginx).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream forgejo_backend {
    server forgejo:3000;
}

upstream vault_backend {
    server vault:8200;
}

# litellm is an optional profiled service — it may not be running.
# Using a variable in proxy_pass with a resolver defers DNS resolution
# to request time, so nginx starts even when litellm is absent.
# The resolver uses Docker's embedded DNS (127.0.0.11).

include /etc/nginx/user.d/*.conf;

# Public share routes rendered by `cove tunnel` (empty file when no shares).
include /etc/nginx/cove-tunnel-shares.conf;

# Default server — catches direct IP access (LAN, Tailscale).
# Serves the Cove landing page so direct IP access shows the portal.
server {
    listen 443 ssl default_server;
    listen 80 default_server;
    server_name _;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    if ($scheme = http) {
        return 301 https://$host$request_uri;
    }

    include /etc/nginx/cove-config-locations.conf;

    root /usr/share/nginx/html;
    try_files /landing.html =404;
}

# cove.local — landing page / service portal
server {
    listen 443 ssl;
    server_name cove cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    root /usr/share/nginx/html;
    try_files /landing.html =404;

    location = /_health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}

# hc.cove — health check endpoint
server {
    listen 443 ssl;
    server_name hc.cove hc.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    location / {
        add_header Content-Type text/plain;
        add_header Access-Control-Allow-Origin "*";
        return 200 "cove ingress ok\n";
    }
}

# ca.cove — redirect to the config page where the root CA can be downloaded
server {
    listen 443 ssl;
    server_name ca.cove ca.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    return 301 https://git.cove/config/ca;
}

# git.cove — forgejo
server {
    listen 443 ssl;
    server_name git.cove git.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    include /etc/nginx/cove-config-locations.conf;

    location / {
        proxy_pass http://forgejo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

