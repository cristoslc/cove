# litellm.cove — LiteLLM proxy
# litellm is an optional profiled service. Using a variable for the
# upstream host defers DNS resolution to request time, so nginx starts
# even when the litellm container is not running.
# All paths are proxied — isolation is from the 127.0.0.1 port binding,
# not route whitelisting. Admin UI is enabled with a master key.
server {
    listen 443 ssl;
    server_name litellm.cove litellm.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    resolver 127.0.0.11 valid=10s;
    set $litellm_upstream http://litellm:4000;

    location / {
        proxy_pass $litellm_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# speedtest.cove — Speedtest Tracker
# speedtest-tracker is an optional profiled service. Using a variable for
# the upstream host defers DNS resolution to request time, so nginx starts
# even when the speedtest-tracker container is not running.
# All paths are proxied — isolation is from the 127.0.0.1 port binding and
# the app's own login gate (Speedtest Tracker enforces login on first run).
server {
    listen 443 ssl;
    server_name speedtest.cove speedtest.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    resolver 127.0.0.11 valid=10s;
    set $speedtest_upstream http://speedtest-tracker:80;

    location / {
        proxy_pass $speedtest_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# mcp.cove — ToolHive MCP gateway (control plane)
# toolhive is an optional profiled service. Using a variable for the
# upstream host defers DNS resolution to request time, so nginx starts
# even when the toolhive container is not running.
# The upstream targets the CONTAINER port (8080) on the compose network —
# nginx is inside the network; ${TOOLHIVE_PORT} is the loopback-only host
# port. HTTP/1.1 + Upgrade/Connection + long timeouts and buffering off
# for streamable HTTP/SSE.
server {
    listen 443 ssl;
    server_name mcp.cove mcp.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    resolver 127.0.0.11 valid=10s;
    set $toolhive_upstream http://toolhive:8080;

    location / {
        proxy_pass $toolhive_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

# ade.cove — bb server (ADE / agentic harness)
# ade is an optional profiled service. Direct-URL mode's public API is
# unauthenticated by design (bb "security-sensitive" wildcard bind); the trust
# boundary is the Cove network and this ingress. See docs/services/ade.md.
# The upstream is a variable so nginx starts even when the container is absent.
server {
    listen 443 ssl;
    server_name ade.cove ade.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    resolver 127.0.0.11 valid=10s;
    set $ade_upstream http://ade:{{ ade_port | default('38886') }};

    location / {
        # bb direct-URL mode is unauthenticated and permits command execution
        # and file reads. Operator decision 2026-09-25: allow private-range
        # clients (LAN RFC1918, tailnet CGNAT 100.64/10, container ranges,
        # loopback); deny public internet. Ingress auth is a planned addition;
        # until then the private-range boundary is the control.
        allow 127.0.0.1;
        allow ::1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        allow 100.64.0.0/10;
        deny all;

        proxy_pass $ade_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}

# Per-machine forge — git.cove.<slug> and cove.<slug>
server {
    listen 443 ssl;
    server_name ~^git\.cove\.[a-zA-Z0-9-]+$ ~^git\.cove\.local\.[a-zA-Z0-9-]+$ ~^cove\.[a-zA-Z0-9-]+$ ~^cove\.local\.[a-zA-Z0-9-]+$;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    include /etc/nginx/cove-config-locations.conf;

    location / {
        proxy_pass http://forgejo_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

