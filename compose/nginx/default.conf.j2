# pages.cove — pages list / portal
server {
    listen 443 ssl;
    server_name pages.cove pages.cove.local;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    root /usr/share/nginx/html;
    try_files /pages.html =404;

    include /etc/nginx/cove-pages-locations.conf;

    location = /_health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}

# pages subdomain — *.pages.cove
server {
    listen 443 ssl;
    server_name ~^(?<owner>[a-zA-Z0-9-]+)\.pages\.cove$;

    ssl_certificate     /certs/cove.local.pem;
    ssl_certificate_key /certs/cove.local-key.pem;

    root /data/pages/sites/$owner;

    location / {
        try_files /.index$uri /.index$uri/index.html $uri $uri/index.html =404;
    }

    location = /_health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

# pages subdomain — *.pages.cove.local
server {
    listen 443 ssl;
    server_name ~^(?<owner>[a-zA-Z0-9-]+)\.pages\.cove\.local$;

    ssl_certificate     /certs/cove.local.pem;
