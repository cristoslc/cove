---
# Host-specific vars overlay (auto-generated by `cove up` on first run).
# Copy to <hostname>.yml and edit, or let `cove up` detect values.
#
# admin_username: your-username        # from $COVE_ADMIN_USERNAME or $USER
# admin_email: you@example.com         # from $COVE_ADMIN_EMAIL or `git config user.email`
# op_vault: Private                    # from $COVE_OP_VAULT or "Private"
# ts_dns_name: your-host.ts.net        # from $COVE_TS_DNS_NAME or `tailscale status --json`
#                                       # falls back to "localhost" with a warning if tailscale absent.
#
# Env overrides for compose resolution:
#   COVE_COMPOSE_DIR   Point `cove up`/`cove down` at an alternate compose/ dir.